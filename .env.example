# ==============================================================================
# Lumière Nails - Environment Variables Configuration Template
# NOTE: Never commit production credentials or secrets to version control.
# ==============================================================================

# Database Connection (Used for Drizzle migrations and direct Postgres operations)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Supabase API Configuration (Server-Side)
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Supabase Client Configuration (Vite Client-Side)
# ONLY public keys are exposed here. NEVER expose service_role or API keys.
VITE_SUPABASE_URL="https://[project-ref].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Web Push Notification VAPID Keys
# Generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgUOflTzx30TCxLkBEcqioBl3g3xQ8AVMis"
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgUOflTzx30TCxLkBEcqioBl3g3xQ8AVMis"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:support@lumierenails.com"

# Resend Email Provider (Server-Side / Supabase Edge Function Secrets)
# Never expose RESEND_API_KEY to Vite frontend
RESEND_API_KEY="re_123456789_abcdefg"
RESEND_FROM_EMAIL="Lumière Nails <onboarding@resend.dev>"

# Meta WhatsApp Business Cloud API (Server-Side / Supabase Edge Function Secrets)
# Never expose WhatsApp credentials to Vite frontend
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="100012345678901"
WHATSAPP_API_VERSION="v21.0"

# WhatsApp Approved Template Names
WHATSAPP_TEMPLATE_CONFIRMATION="appointment_confirmation"
WHATSAPP_TEMPLATE_REMINDER_24H="appointment_reminder_24h"
WHATSAPP_TEMPLATE_REMINDER_1H="appointment_reminder_1h"
WHATSAPP_TEMPLATE_CANCELLATION="appointment_cancellation"

# Scheduled Reminder Processor Settings
REMINDER_24H_WINDOW_MINUTES=10
REMINDER_1H_WINDOW_MINUTES=10
SALON_TIMEZONE="Asia/Jerusalem"

# Initial Studio Admin Account
ADMIN_EMAIL="admin@lumierenails.com"
